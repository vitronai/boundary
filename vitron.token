version: VITRON-EA1
description: Vitron Ethical Automation Protocol v1

compliance:
  public_repo_required: true
  directory: /boundary/
  required_files:
    - NOTICE.md
    - boundaries.token
    - README.md
  optional_files:
    - prompts/
  
ethics:
  llm_scraping_disallowed: true
  offline_only_operation: true
  closed_source_support: true
  agent_boundary_declaration: true

legal:
  license_recommendation: Custom or OSI-approved with proprietary guardrails
  usage_notes: This token certifies adherence to the Vitron Ethical Standard for offline AI automation.

maintainer: vitron.ai
author: Anonymous
token: VITRON-EA1
